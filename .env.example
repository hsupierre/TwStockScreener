# 複製成 .env.local（前端）並視需要填值。不要把真正的 key commit 進版控。

# ── 網站 ───────────────────────────────────────────────
# 正式網址，用於 metadata、sitemap、OG 圖（本機開發可以不填）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase（Project Settings → API）────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# 公開的 publishable / anon key，受 RLS 保護，可以在瀏覽器端使用
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 機密的 service_role / secret key，會略過 RLS。只能給 ETL 與伺服器端使用，絕對不能加 NEXT_PUBLIC_ 前綴
SUPABASE_SERVICE_ROLE_KEY=

# ── 快取失效 webhook ────────────────────────────────────
# ETL 跑完後呼叫 POST /api/revalidate 時帶的密鑰（至少 32 字元，可用 `openssl rand -hex 32` 產生）
REVALIDATE_SECRET=

# ── 每日健康檢查（Vercel Cron → /api/cron/health）─────────────
# Vercel Cron 呼叫時會帶 Authorization: Bearer <CRON_SECRET>（至少 32 字元）
CRON_SECRET=
# 選填：fine-grained token，只授權本 repo 的 Actions 讀寫；ETL 停擺超過 72 小時時用來重新啟用並觸發 ETL
GITHUB_ACTIONS_TOKEN=
# 選填：預設 hsupierre/TwStockScreener
GITHUB_REPOSITORY=

# ── ETL（etl/ 目錄，GitHub Actions secrets 也要設定同名變數）──
# 選填：FinMind 免費 token，只在官方資料缺漏時補資料用
FINMIND_TOKEN=
